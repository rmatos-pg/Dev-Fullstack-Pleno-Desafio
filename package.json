{
  "name": "oee-challenge",
  "private": true,
  "version": "0.1.0",
  "description": "Arquitetura OEE IoT (MQTT) — microsserviços lógicos + núcleo executável",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "npm run build --workspaces --if-present",
    "validate:openapi": "redocly lint services/dashboard-api/openapi.yaml --config redocly.yaml",
    "validate:schemas": "npm run validate -w @oee/mqtt-contracts --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@redocly/cli": "^1.34.0",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8",
    "yaml": "^2.7.0"
  }
}
