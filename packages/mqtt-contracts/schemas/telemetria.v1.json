{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oee.local/schemas/telemetria.v1.json",
  "title": "telemetria.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "maquina_id",
    "ts_sensor",
    "rpm",
    "voltas_acumuladas",
    "temperatura_c",
    "vibracao_mm_s"
  ],
  "properties": {
    "schema": { "const": "telemetria.v1" },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identificador único do evento para idempotência (ADR-002)."
    },
    "maquina_id": { "type": "string", "minLength": 1 },
    "ts_sensor": { "type": "string", "format": "date-time" },
    "rpm": { "type": "number" },
    "voltas_acumuladas": { "type": "integer", "minimum": 0 },
    "temperatura_c": { "type": "number" },
    "vibracao_mm_s": { "type": "number", "minimum": 0 }
  }
}
